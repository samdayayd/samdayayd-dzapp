# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# SQLite dev database
/prisma/dev.db
/prisma/dev.db-journal

# user-uploaded content — served via src/app/api/uploads, not Next's
# public/ static pipeline (which ignores files written after build)
/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts
