generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FuelType {
  ESSENCE
  DIESEL
  ELECTRIQUE
  HYBRIDE
  GPL
}

enum Country {
  FRANCE
  ALGERIE
}

enum ListingStatus {
  ACTIVE
  SOLD
  HIDDEN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  listings      Listing[]
  favorites     Favorite[]
  sentMessages  Message[]      @relation("MessagesSent")
  conversationsAsBuyer  Conversation[] @relation("Buyer")
  conversationsAsSeller Conversation[] @relation("Seller")
}

model Listing {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Int
  currency      String        @default("EUR")
  country       Country
  city          String

  // Voitures-specific fields (MVP category)
  make          String
  model         String
  year          Int
  mileageKm     Int
  fuelType      FuelType

  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        User          @relation(fields: [sellerId], references: [id])
  sellerId      String

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([country, city])
  @@index([make, model])
  @@index([price])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  position  Int      @default(0)

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([userId, listingId])
}

model Conversation {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())

  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String

  buyer      User      @relation("Buyer", fields: [buyerId], references: [id])
  buyerId    String
  seller     User      @relation("Seller", fields: [sellerId], references: [id])
  sellerId   String

  messages   Message[]

  @@unique([listingId, buyerId])
}

model Message {
  id             String       @id @default(cuid())
  body           String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])
  senderId       String
}
