generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type — these are validated at the application
// layer instead (see the allow-lists in src/app/api/listings/route.ts and
// src/app/api/properties/route.ts).
// Valid values: FuelType = ESSENCE | DIESEL | ELECTRIQUE | HYBRIDE | GPL
//               Country  = FRANCE | ALGERIE
//               ListingStatus = ACTIVE | SOLD | HIDDEN
//               SaleType = VENTE | LOCATION
//               PropertyType = APPARTEMENT | MAISON | TERRAIN | LOCAL
//               ItemCategory = ELECTRONIQUE | MEUBLE | VETEMENTS | LOISIRS | MAISON | AUTRE
//               ItemCondition = NEUF | OCCASION

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  listings      Listing[]
  properties    Property[]
  items         Item[]
  favorites     Favorite[]
  sentMessages  Message[]      @relation("MessagesSent")
  conversationsAsBuyer  Conversation[] @relation("Buyer")
  conversationsAsSeller Conversation[] @relation("Seller")
  resetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model Listing {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Int
  currency      String        @default("EUR")
  country       String
  city          String
  saleType      String        @default("VENTE")

  // Voitures-specific fields (MVP category)
  make          String
  model         String
  year          Int
  mileageKm     Int
  fuelType      String

  // How to actually reach the seller — the messaging feature below
  // (Conversation/Message) isn't wired up to any UI yet, so this is
  // the only way a buyer can contact them today.
  contactName   String
  contactEmail  String
  contactPhone  String

  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        User          @relation(fields: [sellerId], references: [id])
  sellerId      String

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([country, city])
  @@index([make, model])
  @@index([price])
  @@index([saleType])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  position  Int      @default(0)

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

model Property {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Int
  currency      String        @default("EUR")
  country       String
  city          String
  saleType      String        @default("VENTE")

  // Immobilier-specific fields
  propertyType  String
  rooms         Int
  surfaceM2     Int

  contactName   String
  contactEmail  String
  contactPhone  String

  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        User          @relation(fields: [sellerId], references: [id])
  sellerId      String

  images        PropertyImage[]

  @@index([country, city])
  @@index([propertyType])
  @@index([price])
  @@index([saleType])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  position   Int      @default(0)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
}

model Item {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Int
  currency      String        @default("EUR")
  country       String
  city          String

  // Achat/Vente-specific fields — general goods, always a straight sale
  // (no rent concept here), so there's no saleType like Listing/Property.
  itemCategory  String
  condition     String        @default("OCCASION")

  contactName   String
  contactEmail  String
  contactPhone  String

  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        User          @relation(fields: [sellerId], references: [id])
  sellerId      String

  images        ItemImage[]

  @@index([country, city])
  @@index([itemCategory])
  @@index([price])
}

model ItemImage {
  id       String @id @default(cuid())
  url      String
  position Int    @default(0)

  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([userId, listingId])
}

model Conversation {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())

  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String

  buyer      User      @relation("Buyer", fields: [buyerId], references: [id])
  buyerId    String
  seller     User      @relation("Seller", fields: [sellerId], references: [id])
  sellerId   String

  messages   Message[]

  @@unique([listingId, buyerId])
}

model Message {
  id             String       @id @default(cuid())
  body           String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])
  senderId       String
}
